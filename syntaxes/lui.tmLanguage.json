{
  "scopeName": "text.lui",
  "patterns": [
    { "include": "#comment" },
    { "include": "#tag" },
    { "include": "#binding" }
  ],
  "repository": {
    "comment": { "name": "comment.block.lui", "begin": "<!--", "end": "-->" },
    "tag": { "begin": "</?", "end": ">", "name": "meta.tag.lui", "patterns": [
      { "match": "[^\\s<>/=\\\"']+", "name": "entity.name.tag.lui" },
      { "match": "[^\\s<>/=\\\"']+(?=\\s*=)", "name": "entity.other.attribute-name.lui" },
      { "begin": "\"", "end": "\"", "name": "string.quoted.double.lui" }
    ] },
    "binding": { "match": "\\{(?:绑定|动作|Binding|Action)\\s+[^}]+\\}", "name": "variable.other.binding.lui" }
  }
}
