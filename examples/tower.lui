<页面 名称="Tower" 副名称="无尽塔">
  <!-- 副名称只在设计器中显示，实际文案由 Text 决定。 -->
  <网格 名称="BattleArea" 副名称="战斗区域" 宽度="100%" 高度="100%" 内边距="8" 行定义="自动,填充" 行间距="10">
    <文本 名称="Title" 副名称="页面标题" 文本="{绑定 view.title, 模式=单向, 更新源触发=默认, 预览内容='第 12 层'}" 字号="20" 网格.行="0" />
    <画布 名称="BattleCanvas" 副名称="战斗画布" 网格.行="1">
      <按钮 名称="OpenSettings" 副名称="打开设置" 文本="设置" 点击="{动作 OpenSettings}" 样式="次要" 画布.右="0" 画布.下="0" />
    </画布>
  </网格>
</页面>
