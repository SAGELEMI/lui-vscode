<页面 名称="Welcome" 副名称="欢迎示例" 宽度="390" 高度="844">
  <容器 子项排列="垂直" 内边距="20" 垂直间隔="12">
    <文本 文本="{绑定 view.title, 预览内容='你好，LUI'}" 字号="28" />
    <文本 引用="CounterText" 文本="{绑定 view.counterText, 预览内容='点击次数：0'}" />
    <按钮 文本="增加一次" 点击="{动作 Increment}" />
    <按钮 文本="查看物品" 点击="{动作 OpenInventory}" />
  </容器>
</页面>
